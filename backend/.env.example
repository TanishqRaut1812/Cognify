# COGNIFY BACKEND ENVIRONMENT CONFIGURATION TEMPLATE

PORT=3000
NODE_ENV=production
FRONTEND_URL=http://localhost:4200

# NEON POSTGRESQL CONNECTION POOL
NEON_DATABASE_URL=postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-xyz-pooler.eastus2.azure.neon.tech/neondb?sslmode=require

# NEON OBJECT STORAGE S3 CREDENTIALS
NEON_STORAGE_ENDPOINT=https://ep-xyz.storage.c-5.us-east-2.aws.neon.tech
NEON_STORAGE_ACCESS_KEY=your_neon_storage_access_key_here
NEON_STORAGE_SECRET_KEY=your_neon_storage_secret_key_here
NEON_STORAGE_REGION=us-east-2

# JWT AUTHENTICATION
JWT_SECRET=your_production_jwt_secret_key_here
ADMIN_PASSWORD_HASH=$2a$12$eImiG9B22N2... # Bcrypt pre-hashed admin password
