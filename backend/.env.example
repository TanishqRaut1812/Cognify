# COGNIFY BACKEND ENVIRONMENT CONFIGURATION

PORT=3000
NODE_ENV=development

# NEON POSTGRESQL POOLED CONNECTION STRING
NEON_DATABASE_URL=postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-xyz-pooler.eastus2.azure.neon.tech/neondb?sslmode=require

# ADMIN AUTHENTICATION
ADMIN_PASSWORD_HASH=$2a$12$eImiG9B22N2... # Pre-hashed admin password
JWT_SECRET=cognify-jwt-secret-key-2026-super-secure
JWT_EXPIRES_IN=12h

# CLOUDFLARE R2 / AWS S3 OBJECT STORAGE (OPTIONAL FOR FILE ATTACHMENTS)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=cognify-resources
